{
  "author": "Manuel Sun",
  "target_version": "2022 R1",
  "executable": null,
  "installation_roots": [],
  "search_roots": [],
  "discovery_max_depth": 7,
  "dimension": "3d",
  "precision": "double",
  "parallel": false,
  "processors": 1,
  "gui": false,
  "extra_args": [],
  "transport": "auto",
  "working_directory": null,
  "logs_root": "../logs",
  "encoding": "gb18030",
  "journal_encoding": "utf-8",
  "startup_timeout": 120,
  "command_timeout": 30,
  "journal_timeout": 300,
  "prompt_settle_seconds": 0.3,
  "probe_command": "/report/system/sys-stats",
  "probe_expect_regex": "Hostname|CPU|System Mem",
  "max_auto_retries": 3
}
